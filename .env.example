APP_NAME="Disaster Response Information Management System (DRIMS)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Optional Geoapify integration. Use the same domain-restricted key for the
# server reverse-geocoder and MapLibre vector style. OpenStreetMap/Nominatim
# remain the automatic no-key fallbacks.
GEOAPIFY_API_KEY=
VITE_GEOAPIFY_API_KEY=

# -----------------------------------------------------------------------------
# Realtime (Socket.IO) — optional; the app works without it (polls as fallback).
# Start: npm run realtime   OR   npm run dev (vite + realtime + scheduler)
# Node gateway: realtime/server.mjs  (public :6001, internal publish :6002)
#
# Herd serves the site over HTTPS, so the browser MUST use WSS:
#   SOCKET_IO_PUBLIC_URL=https://YOUR-HERD-HOST:6001
# (ws:// from an https page is blocked as mixed content.)
# The gateway loads Herd TLS certs from ~/.config/herd/config/valet/Certificates
# (e.g. HOST.lan.crt / HOST.test.crt matching APP_URL hostname).
#
# Plain http://localhost:8000 PHP artisan serve can use:
#   SOCKET_IO_PUBLIC_URL=http://localhost:6001
# -----------------------------------------------------------------------------
SOCKET_IO_ENABLED=false
SOCKET_IO_PUBLIC_URL=http://localhost:6001
SOCKET_IO_PUBLIC_PORT=6001
SOCKET_IO_PUBLIC_HOST=0.0.0.0
SOCKET_IO_INTERNAL_URL=http://127.0.0.1:6002
SOCKET_IO_TOKEN_TTL=90
SOCKET_IO_SECRET=
# Optional comma-separated extra browser origins (APP_URL origin is always allowed)
SOCKET_IO_ALLOWED_ORIGINS=
# Optional explicit Herd cert paths if auto-detect fails
# SOCKET_IO_CERT=
# SOCKET_IO_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drmd_focrg_is
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dswd.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_WORKSHEET="Warehouse Inventory"
GOOGLE_RIS_AUTO_SYNC_ENABLED=true
GOOGLE_STF_AUTO_SYNC_ENABLED=true
GOOGLE_WAREHOUSE_MASTER_URL=
GOOGLE_WAREHOUSE_MASTER_WORKSHEET="Managed Warehouses"
GOOGLE_WAREHOUSE_STOREKEEPERS_WORKSHEET="Managed Warehouses 2"
GOOGLE_STANDBY_FUND_CELL=M2
GOOGLE_RIS_TRACKING_SPREADSHEET_ID=1SBk2PJyS44KS4ftAsjvV9q31GdIEodanrHZOWMScsEw
# RIS tracking tab: AU Name of Driver, AV Contact Number of Driver, AW Plate, AX Received By
GOOGLE_RIS_TRACKING_GID=1905199506
GOOGLE_RIS_ITEMS_GID=482002664
GOOGLE_STF_TRACKING_SPREADSHEET_ID=1SBk2PJyS44KS4ftAsjvV9q31GdIEodanrHZOWMScsEw
GOOGLE_STF_TRACKING_GID=1367120220
GOOGLE_STF_ITEMS_GID=1927904915

PSGC_API_BASE_URL=https://psgc.cloud/api
PSGC_PUBLICATION_URL=https://psa.gov.ph/system/files/scd/PSGC-1Q-2026-Publication-Datafile.xlsx
PSGC_PUBLICATION_NAME="PSGC 1Q 2026 Publication Datafile"
PSGC_ALLOW_API_FALLBACK=false

CC_OAUTH_CLIENT_ID=
CC_OAUTH_SECRET=
CC_OAUTH_AUTHORIZE_URL=https://caraga-connect-api-staging.dswd.gov.ph/sso/login
CC_OAUTH_TOKEN_URL=https://caraga-connect-api-staging.dswd.gov.ph/oauth/token
CC_OAUTH_USERINFO_URL=https://caraga-connect-api-staging.dswd.gov.ph/api/userinfo
MYPORTAL_LOGIN_URL=https://caraga-connect.dswd.gov.ph/api/v1/staff/login
MYPORTAL_ME_DETAILS_URL=https://caraga-connect.dswd.gov.ph/api/v1/staff/portal/me/details
MYPORTAL_ACCESS_TOKEN=
MYPORTAL_EMPLOYEE_DIRECTORY_TOKEN=
MYPORTAL_USERNAME=
MYPORTAL_PASSWORD=
MYPORTAL_TOKEN_CACHE_SECONDS=3300
MYPORTAL_TRUSTED_MEDIA_HOSTS=caraga-portal.dswd.gov.ph,caraga-connect.dswd.gov.ph
CC_OAUTH_LOGOUT_URL=https://caraga-connect-api-staging.dswd.gov.ph/api/sso/logout
CC_OAUTH_LOGOUT_ALL_URL=https://caraga-connect-api-staging.dswd.gov.ph/api/sso/logout-all
CC_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/login-sso/callback
CC_OAUTH_SCOPE="openid profile email"
CC_OAUTH_VERIFY_SSL=false

# e-PIRMA — https://caraga-connect-dev.dswd.gov.ph/docs/epirma-php
# 1) Register: POST /epirma/register-client {"name":"DROMIS"} (LDAP / Caraga Connect)
# 2) Authorize: POST {EPIRMA_BASE_URL}/api/microservice/build-authorize
# 3) Redirect: {EPIRMA_BASE_URL}/microservice/document-routing?...&token=...
EPIRMA_BASE_URL=https://caraga-epirma-staging.dswd.gov.ph
EPIRMA_CLIENT_SECRET=
EPIRMA_APP_NAME=DROMIS
EPIRMA_LOCAL_BYPASS=false
EPIRMA_VERIFY_SSL=
EPIRMA_ALLOW_INSECURE_SSL=true
# Public-secure-file download token from RICTMS (may be base64:…). Used as ?token=
# on signed PDF GETs. Distinct from APP_KEY and from Connect CSRF / staff bearer.
# Never set this to APP_KEY (that value is ignored). Ask RICTMS if downloads 403.
EPIRMA_DOCUMENT_TOKEN=
# Optional employee id_number for build-authorize when downloading signed PDFs.
EPIRMA_DOWNLOAD_ID_NUMBER=
# Retry downloads on these hosts when the remote URL host fails DNS (comma-separated).
EPIRMA_HOST_FALLBACKS=
# Force DNS for dead hostnames: host=ip;host2=ip2 (used via CURLOPT_RESOLVE).
EPIRMA_RESOLVE_MAP=
EPIRMA_FORCE_HTTPS_URLS=false
# Optional public root so staging e-PIRMA can fetch PDFs (leave empty for APP_URL).
EPIRMA_PUBLIC_APP_URL=
# Legacy handoff only if microservice is not configured.
EPIRMA_SIGN_URL=
# Caraga Connect staff API — signed PDF enrichment via forwarded-documents.
# EPIRMA_CONNECT_BASE_URL must match the e-PIRMA environment (connect-dev for
# caraga-epirma-dev). Auth: EPIRMA_CONNECT_BEARER, or MYPORTAL_ACCESS_TOKEN /
# MYPORTAL_USERNAME+PASSWORD. Login host MUST be the same Connect host:
#   EPIRMA_CONNECT_LOGIN_URL=https://caraga-connect-dev.dswd.gov.ph/api/v1/staff/login
# Prod Connect tokens cannot call connect-dev (HTTP 401 Unauthenticated).
EPIRMA_CONNECT_BASE_URL=
EPIRMA_CONNECT_LOGIN_URL=
EPIRMA_CONNECT_BEARER=
EPIRMA_CONNECT_CSRF_TOKEN=
# Custodian Connect username whose forwarded-documents list includes signed PDFs
# (e.g. rlongue). When empty, uses initiating AA username / MYPORTAL_USERNAME.
EPIRMA_FORWARDED_DOCUMENTS_USERNAME=
EPIRMA_REGISTER_BASE_URL=https://caraga-connect-dev.dswd.gov.ph
EPIRMA_REGISTER_PATH=/api/v1/staff/epirma/register-client

CC_SSO_DEFAULT_ROLE=guest
CC_SSO_DEFAULT_OFFICE=DRRS
CC_SSO_BYPASS_MFA=false
