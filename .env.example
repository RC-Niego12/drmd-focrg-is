APP_NAME="Disaster Response Information Management System (DRIMS)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drmd_focrg_is
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dswd.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_WORKSHEET="Warehouse Inventory"
GOOGLE_WAREHOUSE_MASTER_URL=
GOOGLE_WAREHOUSE_MASTER_WORKSHEET="Managed Warehouses"

PSGC_API_BASE_URL=https://psgc.cloud/api
PSGC_PUBLICATION_URL=https://psa.gov.ph/system/files/scd/PSGC-1Q-2026-Publication-Datafile.xlsx
PSGC_PUBLICATION_NAME="PSGC 1Q 2026 Publication Datafile"
PSGC_ALLOW_API_FALLBACK=false

CC_OAUTH_CLIENT_ID=
CC_OAUTH_SECRET=
CC_OAUTH_AUTHORIZE_URL=https://caraga-connect-api-staging.dswd.gov.ph/sso/login
CC_OAUTH_TOKEN_URL=https://caraga-connect-api-staging.dswd.gov.ph/oauth/token
CC_OAUTH_USERINFO_URL=https://caraga-connect-api-staging.dswd.gov.ph/api/userinfo
CC_OAUTH_LOGOUT_URL=https://caraga-connect-api-staging.dswd.gov.ph/api/sso/logout
CC_OAUTH_LOGOUT_ALL_URL=https://caraga-connect-api-staging.dswd.gov.ph/api/sso/logout-all
CC_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/login-sso/callback
CC_OAUTH_SCOPE="openid profile email"
CC_OAUTH_VERIFY_SSL=false

# e-PIRMA signing application entry point. The application appends the
# transaction, assessment document, callback, and return URLs.
EPIRMA_SIGN_URL=
CC_SSO_DEFAULT_ROLE=DRRS
CC_SSO_DEFAULT_OFFICE=DRRS
